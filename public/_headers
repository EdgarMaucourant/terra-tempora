# Cache rules for Cloudflare Pages (Netlify reads this file too).
# Built scripts and styles have a hash in their name, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Data files keep their names between releases: browsers reuse them for an
# hour, then check for a newer copy while showing the one they have.
/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# CesiumJS runtime files change only when the library is upgraded.
/cesium/*
  Cache-Control: public, max-age=604800
